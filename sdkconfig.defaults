# ESP32-2432S028 (classic ESP32-WROOM-32, 4 MB flash)
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Bluetooth: NimBLE, BLE only, central role, big MTU for the 512-byte dump packets
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=24
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144
CONFIG_BT_NIMBLE_LOG_LEVEL_INFO=y
# The pedal needs no pairing: no security manager
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n

# LVGL 9: 16-bit colour, heap allocator (the builtin 64 KB pool does not fit static DRAM),
# only the fonts and widgets the screen uses
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
CONFIG_LV_USE_LOG=n
CONFIG_LV_DEF_REFR_PERIOD=33
# Widgets: label, bar, slider, keyboard (+ button matrix, text area) and plain objects; flex for the
# Wi-Fi list; the default theme. Everything else off.
CONFIG_LV_USE_ANIMIMG=n
CONFIG_LV_USE_ARC=n
CONFIG_LV_USE_ARCLABEL=n
CONFIG_LV_USE_CALENDAR=n
CONFIG_LV_USE_CANVAS=n
CONFIG_LV_USE_CHART=n
CONFIG_LV_USE_CHECKBOX=n
CONFIG_LV_USE_DROPDOWN=n
CONFIG_LV_USE_IMAGEBUTTON=n
CONFIG_LV_USE_LED=n
CONFIG_LV_USE_LINE=n
CONFIG_LV_USE_LIST=n
CONFIG_LV_USE_MENU=n
CONFIG_LV_USE_MSGBOX=n
CONFIG_LV_USE_ROLLER=n
CONFIG_LV_USE_SCALE=n
CONFIG_LV_USE_SPAN=n
CONFIG_LV_USE_SPINBOX=n
CONFIG_LV_USE_SPINNER=n
CONFIG_LV_USE_SWITCH=n
CONFIG_LV_USE_TABLE=n
CONFIG_LV_USE_TABVIEW=n
CONFIG_LV_USE_TILEVIEW=n
CONFIG_LV_USE_WIN=n
CONFIG_LV_USE_GRID=n
CONFIG_LV_USE_OBSERVER=n
CONFIG_LV_USE_THEME_SIMPLE=n
CONFIG_LV_USE_THEME_MONO=n
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n

# Board (components/cyd_board/Kconfig): CYD2USB variant, bench-checked 2026-09-26
CONFIG_CYD_PANEL_ST7789=y
CONFIG_CYD_PANEL_INVERT=n
CONFIG_CYD_ROTATE_180=n
CONFIG_CYD_TOUCH_MIRROR_X=n
CONFIG_CYD_TOUCH_MIRROR_Y=n

# Firmware updates over Wi-Fi (components/nano_ota): two 1.94 MB OTA slots (partitions.csv), the
# bootloader rolls back an image that never calls nano_ota_mark_valid, HTTPS with the common CA set.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
# A station that downloads over HTTPS: no TLS server, no access point, no WPA enterprise
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
# Download heap (measured 2026-10-03: the first OTA failed mid-download, heap down to 9 KB): TLS takes its
# 16 KB record buffer once per connection, while the heap is still whole (dynamic buffers re-allocate it
# for every record and lost to fragmentation), and Wi-Fi may hold at most 16 received packets, not 32.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=n
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
# Wi-Fi + Bluetooth overflow the classic ESP32's IRAM: Wi-Fi fast paths run from flash (a slower
# download is fine, Wi-Fi only runs in update mode).
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
